{
  "settings": [
	{
  "id": "retdata",
  "name": "Output data specification",
  "description": "Choose whether to output the full input dataset or only flight locations, defined as locations with ground speed above the estimated antimode.",
  "defaultValue": "all",
  "type": "RADIOBUTTONS",
  "options": [
    {
      "value": "all",
      "displayText": "All data"
    },
    {
      "value": "flight",
      "displayText": "Only flight locations"
    }
  ]
},
{
  "id": "speed_calc",
  "name": "Ground speed calculation",
  "description": "If the dataset does not contain ground speed, choose whether to calculate it as the distance between consecutive locations divided by the time between them using move2::mt_speed().",
  "defaultValue": "yes",
  "type": "RADIOBUTTONS",
  "options": [
    {
      "value": "yes",
      "displayText": "Yes"
    },
    {
      "value": "no",
      "displayText": "No"
    }
  ]
}
      
